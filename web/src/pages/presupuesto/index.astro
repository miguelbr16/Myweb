---
import Base from "../../layouts/Base.astro";
import { site } from "../../content/site";
import { projectTypes, extras, maintenance, formatRange } from "../../content/pricing";
// Configurador: el cliente elige, ve el rango de precio al momento y envía.
// Sin llamadas: el brief completo llega por email (worker/index.ts → /api/presupuesto).
// Sin JavaScript el formulario sigue funcionando; solo se pierde el cálculo en vivo.
const input = "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-brand focus:outline-none";
const card = "flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 bg-white p-4 has-[:checked]:border-brand has-[:checked]:ring-1 has-[:checked]:ring-brand";
---

<Base title="Calcula tu presupuesto" description="Configura tu web, automatización o proyecto de IA y recibe un presupuesto orientativo al instante.">
  <section class="bg-surface">
    <div class="mx-auto max-w-5xl px-4 py-12 md:py-16">
      <h1 class="text-3xl font-extrabold tracking-tight md:text-5xl">Calcula tu presupuesto</h1>
      <p class="mt-3 max-w-2xl text-lg text-muted">Elige lo que necesitas y verás el precio orientativo al momento. Sin llamadas ni compromiso.</p>

      <form id="quote" method="POST" action="/api/presupuesto" class="mt-10 grid gap-10 lg:grid-cols-[1fr_320px]">
        <div class="space-y-10">
          <fieldset>
            <legend class="text-xl font-bold">1. ¿Qué necesitas?</legend>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              {
                Object.entries(projectTypes).map(([key, t], i) => (
                  <label class={card}>
                    <input type="radio" name="type" value={key} required checked={i === 1} class="mt-1" />
                    <span>
                      <span class="block font-semibold">{t.label}</span>
                      <span class="text-sm text-muted">{t.range ? `${formatRange(t.range)} · ${t.days}` : "Propuesta personalizada"}</span>
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset>
            <legend class="text-xl font-bold">2. Extras</legend>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              {
                Object.entries(extras)
                  .filter(([key]) => key !== "language")
                  .map(([key, e]) => (
                    <label class={card}>
                      <input type="checkbox" name="extras" value={key} class="mt-1" />
                      <span>
                        <span class="block font-semibold">{e.label}</span>
                        <span class="text-sm text-muted">+{formatRange(e.range)}</span>
                      </span>
                    </label>
                  ))
              }
            </div>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              <label class="block">
                <span class="text-sm font-medium">Idiomas además del español</span>
                <select name="languages" class={input}>
                  <option value="0">Ninguno</option>
                  <option value="1">1 (p. ej. inglés)</option>
                  <option value="2">2</option>
                  <option value="3">3 o más</option>
                </select>
              </label>
              <label class="flex items-center gap-2 self-end pb-2">
                <input type="checkbox" name="urgent" value="yes" />
                <span class="text-sm">Lo necesito urgente (mitad de plazo, +20 %)</span>
              </label>
            </div>
          </fieldset>

          <fieldset>
            <legend class="text-xl font-bold">3. Mantenimiento mensual</legend>
            <div class="mt-4 grid gap-3 sm:grid-cols-3">
              {
                Object.entries(maintenance).map(([key, m], i) => (
                  <label class={card}>
                    <input type="radio" name="maintenance" value={key} checked={i === 0} class="mt-1" />
                    <span>
                      <span class="block font-semibold">{m.label}</span>
                      <span class="text-sm text-muted">{m.monthly ? `${formatRange(m.monthly)}/mes` : "—"}</span>
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset>
            <legend class="text-xl font-bold">4. Tu negocio y tus datos</legend>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              <label class="block">
                <span class="text-sm font-medium">Nombre del negocio o empresa *</span>
                <input name="business" required maxlength="120" class={input} />
              </label>
              <label class="block">
                <span class="text-sm font-medium">Sector *</span>
                <input name="sector" required maxlength="80" placeholder="p. ej. clínica, restaurante, reformas" class={input} />
              </label>
              <label class="block sm:col-span-2">
                <span class="text-sm font-medium">Web actual o redes (si tienes)</span>
                <input name="current_url" maxlength="300" placeholder="https://… o @instagram" class={input} />
              </label>
              <label class="block">
                <span class="text-sm font-medium">Tu nombre *</span>
                <input name="name" required maxlength="100" autocomplete="name" class={input} />
              </label>
              <label class="block">
                <span class="text-sm font-medium">Email *</span>
                <input name="email" type="email" required maxlength="200" autocomplete="email" class={input} />
              </label>
              <label class="block sm:col-span-2">
                <span class="text-sm font-medium">¿Algo más que debamos saber?</span>
                <textarea name="message" maxlength="2000" rows="3" class={input}></textarea>
              </label>
            </div>
            <div class="hidden" aria-hidden="true">
              <label>No rellenar <input name="company" tabindex="-1" autocomplete="off" /></label>
            </div>
            <label class="mt-4 flex items-start gap-2 text-sm">
              <input type="checkbox" name="privacy" value="yes" required class="mt-1" />
              <span>
                Acepto la <a href="/privacidad" class="underline">política de privacidad</a>. Usaremos tus datos solo
                para enviarte este presupuesto.
              </span>
            </label>
            <div class="cf-turnstile mt-4" data-sitekey={site.turnstileSiteKey} data-language="es"></div>
          </fieldset>
        </div>

        <aside class="lg:sticky lg:top-20 lg:self-start">
          <div class="rounded-2xl bg-ink p-6 text-white">
            <p class="text-sm text-slate-300">Precio orientativo</p>
            <p id="q-oneoff" class="mt-1 text-3xl font-extrabold">—</p>
            <p id="q-monthly" class="mt-1 text-sm text-slate-300"></p>
            <p id="q-days" class="mt-3 text-sm text-slate-300"></p>
            <button type="submit" class="mt-6 w-full rounded-full bg-brand px-6 py-3 font-semibold hover:bg-brand-dark">
              Recibir mi propuesta
            </button>
            <p class="mt-3 text-xs text-slate-400">IVA no incluido. Te confirmamos el precio cerrado por email antes de empezar.</p>
          </div>
        </aside>
      </form>
    </div>
  </section>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</Base>

<script>
  import { estimate, formatRange, isProjectType, isExtra, isMaintenance } from "../../content/pricing";

  const form = document.getElementById("quote") as HTMLFormElement;
  const out = {
    oneOff: document.getElementById("q-oneoff")!,
    monthly: document.getElementById("q-monthly")!,
    days: document.getElementById("q-days")!,
  };

  function update() {
    const data = new FormData(form);
    const type = String(data.get("type") ?? "");
    const maint = String(data.get("maintenance") ?? "none");
    if (!isProjectType(type) || !isMaintenance(maint)) return;
    const result = estimate({
      type,
      extras: data.getAll("extras").map(String).filter(isExtra),
      languages: Number(data.get("languages") ?? 0),
      maintenance: maint,
      urgent: data.get("urgent") === "yes",
    });
    out.oneOff.textContent = result.oneOff ? formatRange(result.oneOff) : "A medida";
    out.monthly.textContent = result.monthly ? `+ ${formatRange(result.monthly)}/mes de mantenimiento` : "";
    out.days.textContent = `Plazo: ${result.days}`;
  }

  form.addEventListener("input", update);
  update();
</script>
