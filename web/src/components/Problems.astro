---
import Section from "./Section.astro";
import { problems } from "../content/site";
---

<Section title={problems.title}>
  <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
    {
      problems.items.map((p, i) => (
        <li class="rounded-2xl border border-slate-200 p-5">
          <span class="text-sm font-bold text-brand">0{i + 1}</span>
          <h3 class="mt-2 font-semibold">{p.title}</h3>
          <p class="mt-1 text-sm text-muted">{p.text}</p>
        </li>
      ))
    }
  </ol>
</Section>
