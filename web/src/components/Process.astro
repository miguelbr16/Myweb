---
import Section from "./Section.astro";
import { process } from "../content/site";
---

<Section id="proceso" title={process.title} subtitle={process.subtitle} muted>
  <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      process.steps.map((s, i) => (
        <li class="rounded-2xl bg-white p-6">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand font-bold text-white">{i + 1}</span>
          <h3 class="mt-4 text-lg font-semibold">{s.title}</h3>
          <p class="mt-2 text-muted">{s.text}</p>
        </li>
      ))
    }
  </ol>
</Section>
