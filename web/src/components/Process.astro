---
import { process } from "../content/home";
---

<section id="como-funciona" class="section">
  <div class="wrap">
    <p class="eyebrow">{process.eyebrow}</p>
    <h2 class="h2 mt-5 max-w-3xl">{process.title}</h2>
    <ol class="mt-14 grid gap-10 md:grid-cols-4 md:gap-6">
      {
        process.steps.map((s, i) => (
          <li class="reveal border-t-4 border-ink pt-5" style={`--step:${i}`} data-step>
            <span class="display block text-5xl">{s.n}</span>
            <p class="eyebrow mt-4 w-fit bg-signal px-2 py-1">{s.tag}</p>
            <h3 class="display mt-4 text-2xl">{s.title}</h3>
            <p class="mt-3 text-muted">{s.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-12 font-semibold">{process.note}</p>
  </div>
</section>

<style>
  /* Escalera: cada paso baja un peldaño (eco del logotipo). Solo en escritorio. */
  @media (min-width: 768px) {
    [data-step] {
      margin-top: calc(var(--step) * 2.5rem);
    }
  }
</style>
