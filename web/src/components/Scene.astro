---
import { scene } from "../content/home";
---

<section class="on-ink section bg-ink text-bone">
  <div class="wrap grid gap-12 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="eyebrow text-signal">{scene.eyebrow}</p>
      <h2 class="h2 mt-5 text-[clamp(1.75rem,3.6vw,2.9rem)]">{scene.title}</h2>
      <p class="mt-5 font-mono text-xs text-fog">{scene.aside}</p>
    </div>
    <div class="md:col-span-6 md:col-start-7">
      <ol class="space-y-0">
        {
          scene.beats.map((b, i) => (
            <li
              class:list={[
                "reveal flex gap-5 border-t-2 border-bone/25 py-6 text-xl leading-snug md:text-2xl",
                i === scene.beats.length - 1 && "-mx-4 border-t-0 bg-signal px-4 text-ink",
              ]}
            >
              <span class="display w-14 shrink-0 text-[1.6rem] opacity-70">{b.n}</span>
              <span class="font-semibold">{b.text}</span>
            </li>
          ))
        }
      </ol>
      <p class="reveal mt-10 max-w-xl text-lg text-bone/90">{scene.close}</p>
    </div>
  </div>
</section>
