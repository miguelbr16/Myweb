---
import Section from "./Section.astro";
import { services } from "../content/site";
---

<Section id="servicios" title={services.title} subtitle={services.subtitle} muted>
  <div class="grid gap-6 md:grid-cols-3">
    {
      services.items.map((s) => (
        <article
          class:list={[
            "flex flex-col rounded-2xl border bg-white p-6",
            "featured" in s && s.featured ? "border-brand shadow-lg" : "border-slate-200",
          ]}
        >
          <h3 class="text-xl font-bold">{s.name}</h3>
          <p class="mt-2 text-3xl font-extrabold text-brand">{s.price}</p>
          <p class="text-sm text-muted">Entrega en {s.time}</p>
          <ul class="mt-6 flex-1 space-y-2 text-sm">
            {s.features.map((f) => <li>✓ {f}</li>)}
          </ul>
          <a href="#contacto" class="mt-6 rounded-full bg-ink px-4 py-2 text-center text-sm font-semibold text-white">
            Pedir presupuesto
          </a>
        </article>
      ))
    }
  </div>
  <p class="mt-8 text-muted">{services.recurring}</p>
</Section>
