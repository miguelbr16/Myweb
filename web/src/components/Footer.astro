---
import Wordmark from "./Wordmark.astro";
import { site } from "../content/site";
const year = new Date().getFullYear();
---

<footer class="on-ink bg-ink text-bone">
  <div class="wrap grid gap-12 py-16 md:grid-cols-12">
    <div class="md:col-span-5">
      <Wordmark invert />
      <p class="mt-6 max-w-sm text-fog">{site.tagline}.</p>
    </div>
    <nav class="md:col-span-3" aria-label="Secciones">
      <p class="eyebrow text-fog">Secciones</p>
      <ul class="mt-4 space-y-2">
        <li><a class="link" href="/#que-hacemos">Qué hacemos</a></li>
        <li><a class="link" href="/#como-funciona">Cómo funciona</a></li>
        <li><a class="link" href="/#precios">Precios</a></li>
        <li><a class="link" href="/presupuesto/">Presupuesto</a></li>
      </ul>
    </nav>
    <div class="md:col-span-4">
      <p class="eyebrow text-fog">Contacto</p>
      <p class="mt-4"><a class="link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
      <p class="mt-1 text-fog">Respondemos en menos de 24 h laborables.</p>
      <nav class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm" aria-label="Legal">
        <a class="link" href="/aviso-legal/">Aviso legal</a>
        <a class="link" href="/privacidad/">Privacidad</a>
        <a class="link" href="/cookies/">Cookies</a>
      </nav>
    </div>
  </div>
  <div class="border-t border-bone/20">
    <p class="wrap py-5 text-sm text-fog">© {year} {site.brand}. {site.contact.city}.</p>
  </div>
</footer>
