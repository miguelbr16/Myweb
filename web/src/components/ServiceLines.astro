---
import Section from "./Section.astro";
import { serviceLines } from "../content/site";
---

<Section id="servicios" title={serviceLines.title} subtitle={serviceLines.subtitle} muted>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      serviceLines.items.map((s) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-6">
          <span class="text-3xl" aria-hidden="true">{s.icon}</span>
          <h3 class="mt-3 text-lg font-bold">{s.title}</h3>
          <p class="mt-2 text-muted">{s.text}</p>
        </article>
      ))
    }
  </div>
</Section>
