---
import { faq } from "../content/home";
---

<!-- Cero JS: <details name> agrupa los elementos y cierra el resto al abrir uno. Misma fuente que el JSON-LD. -->
<section id="preguntas" class="section">
  <div class="wrap grid gap-12 md:grid-cols-12">
    <div class="md:col-span-4">
      <p class="eyebrow">{faq.eyebrow}</p>
      <h2 class="h2 mt-5">{faq.title}</h2>
    </div>
    <div class="md:col-span-8">
      {
        faq.items.map((f) => (
          <details name="faq" class="group border-t-2 border-ink last:border-b-2">
            <summary class="faq-q flex items-start justify-between gap-6 py-5 text-lg font-bold">
              <h3 class="text-lg font-bold">{f.q}</h3>
              <span class="display mt-0.5 text-2xl leading-none transition-transform group-open:rotate-45 motion-reduce:transition-none" aria-hidden="true">+</span>
            </summary>
            <p class="max-w-2xl pb-6 text-muted">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
