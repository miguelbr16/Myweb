---
import Base from "../layouts/Base.astro";
interface Props {
  title: string;
  noindex?: boolean;
}
const { title, noindex = false } = Astro.props;
---

<Base title={title} noindex={noindex}>
  <article class="wrap py-16 md:py-24 [&_a]:underline [&_a]:decoration-signal [&_a]:decoration-2 [&_a]:underline-offset-4 [&_h2]:display [&_h2]:mt-10 [&_h2]:text-2xl [&_li]:mt-1 [&_p]:mt-4 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6">
    <div class="max-w-2xl">
      <h1 class="display text-[clamp(2.25rem,6vw,4rem)]">{title}</h1>
      <slot />
    </div>
  </article>
</Base>
