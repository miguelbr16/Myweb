---
import { hero } from "../content/site";
---

<section class="bg-gradient-to-b from-teal-50 to-white">
  <div class="mx-auto max-w-6xl px-4 py-20 md:py-32">
    <p class="text-sm font-semibold tracking-wide text-brand uppercase">{hero.eyebrow}</p>
    <h1 class="mt-4 max-w-3xl text-4xl font-extrabold tracking-tight md:text-6xl">{hero.title}</h1>
    <p class="mt-6 max-w-2xl text-lg text-muted md:text-xl">{hero.subtitle}</p>
    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <a href="/presupuesto" class="rounded-full bg-brand px-6 py-3 text-center font-semibold text-white hover:bg-brand-dark">
        {hero.ctaPrimary}
      </a>
      <a href="#servicios" class="rounded-full border border-slate-300 px-6 py-3 text-center font-semibold hover:border-ink">
        {hero.ctaSecondary}
      </a>
    </div>
  </div>
</section>
