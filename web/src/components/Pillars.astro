---
import { pillars } from "../content/home";
---

<section id="que-hacemos" class="section">
  <div class="wrap">
    <p class="eyebrow">{pillars.eyebrow}</p>
    <h2 class="h2 mt-5 max-w-3xl">{pillars.title}</h2>
    <div class="mt-14 border-b-2 border-ink">
      {
        pillars.items.map((p) => (
          <article class="reveal grid gap-6 border-t-2 border-ink py-10 md:grid-cols-12 md:gap-8 md:py-14">
            <p class="display text-[clamp(3rem,8vw,6rem)] text-signal [-webkit-text-stroke:2px_var(--color-ink)] md:col-span-2" aria-hidden="true">{p.n}</p>
            <div class="md:col-span-4">
              <p class="eyebrow text-muted">{p.verb}</p>
              <h3 class="display mt-2 text-[clamp(1.75rem,3.4vw,2.5rem)]">{p.title}</h3>
            </div>
            <div class="md:col-span-6">
              <p class="text-lg leading-snug">{p.text}</p>
              <ul class="mt-5 space-y-2 border-l-2 border-signal pl-4">
                {p.list.map((li) => <li>{li}</li>)}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
    <p class="mt-8 max-w-2xl text-muted">{pillars.after}</p>
  </div>
</section>
